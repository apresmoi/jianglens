spawnfile_version: "0.1"
kind: agent
name: virgil
description: "Virgil: processes one ready Jiang Lens video into a public website-visible episode or interview."

runtime:
  name: picoclaw
  options:
    restrict_to_workspace: true

execution:
  model:
    primary:
      provider: openai
      name: gpt-5.4
      auth:
        method: codex
  sandbox:
    mode: workspace

environment:
  env:
    GIT_AUTHOR_NAME: Virgil
    GIT_AUTHOR_EMAIL: virgil@jianglens.com
    GIT_COMMITTER_NAME: Virgil
    GIT_COMMITTER_EMAIL: virgil@jianglens.com

schedule:
  kind: cron
  cron: "3,13,23,33,43,53 * * * *"
  timezone: UTC
  prompt: Wake as Virgil. Read generated workspace context, enter
    ./repos/jiang-lens, read recent episode-floor history, and perform one
    source-to-PR work cycle for the current or next ready source. Carry the
    current source across as many safe stages as possible before stopping; do
    not claim another source while the current branch, PR, QA, repair, or merge
    closeout is unresolved.

workspace:
  docs:
    identity: IDENTITY.md
    soul: SOUL.md
    system: AGENTS.md
    memory: MEMORY.md
    heartbeat: HEARTBEAT.md
    extras:
      setup: SETUP.md
      state: STATE.md
  resources:
    - id: virgil-state
      kind: volume
      mount: ./state
      mode: mutable

surfaces:
  moltnet:
    - network: local_lab
      rooms:
        episode-floor:
          wake: mentions
