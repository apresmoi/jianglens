spawnfile_version: "0.1"
kind: agent
name: dante
description: "Dante: an independent public-lens judge who reviews Plato's concept, atlas, lens-point, and provenance mutations before they merge."

runtime:
  name: picoclaw
  options:
    restrict_to_workspace: true

execution:
  model:
    primary:
      provider: openai
      name: gpt-5.5
      auth:
        method: codex
  sandbox:
    mode: workspace

environment:
  env:
    GIT_AUTHOR_NAME: Dante
    GIT_AUTHOR_EMAIL: dante@jianglens.com
    GIT_COMMITTER_NAME: Dante
    GIT_COMMITTER_EMAIL: dante@jianglens.com

schedule:
  kind: cron
  cron: "23,53 * * * *"
  timezone: UTC
  prompt: "Wake as Dante. Read generated workspace context, enter ./repos/jiang-lens, read recent episode-floor history, and carry at most one waiting public lens mutation PR to PASS, FAIL, auto-merge when safe, or a concrete blocker. Do not process episodes or create lens prose."

surfaces:
  moltnet:
    - network: local_lab
      rooms:
        episode-floor:
          wake: mentions

workspace:
  docs:
    identity: IDENTITY.md
    soul: SOUL.md
    system: AGENTS.md
    memory: MEMORY.md
    heartbeat: HEARTBEAT.md
    extras:
      setup: SETUP.md
      state: STATE.md
  resources:
    - id: dante-state
      kind: volume
      mount: ./state
      mode: mutable
