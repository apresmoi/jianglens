spawnfile_version: "0.1"
kind: agent
name: plato
description: "Plato: stewards the processed Jiang corpus into source-grounded lens concepts, atlas structure, and evidence-linked public pages."

runtime:
  name: picoclaw
  options:
    restrict_to_workspace: true

execution:
  model:
    primary:
      provider: openai
      name: gpt-5.5
      auth:
        method: codex
  sandbox:
    mode: workspace

environment:
  env:
    GIT_AUTHOR_NAME: Plato
    GIT_AUTHOR_EMAIL: plato@jianglens.com
    GIT_COMMITTER_NAME: Plato
    GIT_COMMITTER_EMAIL: plato@jianglens.com

schedule:
  kind: cron
  cron: "56 * * * *"
  timezone: UTC
  prompt: "Wake as Plato. Read generated workspace context, enter ./repos/jiang-lens, read recent episode-floor history, and carry one current or newly selected lens unit as far as safely possible: compact impact intake to merge path, or public lens mutation to PR/Dante handoff. If no fresh source or concrete synthesis target is ready, go idle. Do not claim another unit while a current branch, PR, Dante review, repair, or merge closeout is unresolved. Do not take historical corpus-impact backfill unless the maintainer or Socrates names a bounded source or concept cluster."

surfaces:
  moltnet:
    - network: local_lab
      rooms:
        episode-floor:
          wake: mentions

workspace:
  docs:
    identity: IDENTITY.md
    soul: SOUL.md
    system: AGENTS.md
    memory: MEMORY.md
    heartbeat: HEARTBEAT.md
    extras:
      setup: SETUP.md
      state: STATE.md
  resources:
    - id: plato-state
      kind: volume
      mount: ./state
      mode: mutable
