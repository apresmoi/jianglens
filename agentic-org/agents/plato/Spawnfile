spawnfile_version: "0.1"
kind: agent
name: plato
description: "Plato: stewards the processed Jiang corpus into source-grounded lens concepts, atlas structure, and evidence-linked public pages."

runtime:
  name: picoclaw
  options:
    restrict_to_workspace: true

execution:
  model:
    primary:
      provider: openai
      name: gpt-5.5
      auth:
        method: codex
  sandbox:
    mode: workspace

environment:
  env:
    GIT_AUTHOR_NAME: Plato
    GIT_AUTHOR_EMAIL: plato@jianglens.com
    GIT_COMMITTER_NAME: Plato
    GIT_COMMITTER_EMAIL: plato@jianglens.com

schedule:
  kind: cron
  cron: "56 * * * *"
  timezone: UTC
  prompt: "Wake as Plato. Read generated workspace context, enter ./repos/jiang-lens, read recent episode-floor history, and perform one bounded Plato lens iteration. If a fresh high-pressure source lacks impact, do one compact intake. If recent Plato work is already impact-heavy, synthesize accumulated impacts into a public lens mutation or concept-scoped proposal before taking another historical backfill."

surfaces:
  moltnet:
    - network: local_lab
      rooms:
        episode-floor:
          wake: mentions

workspace:
  docs:
    identity: IDENTITY.md
    soul: SOUL.md
    system: AGENTS.md
    memory: MEMORY.md
    heartbeat: HEARTBEAT.md
    extras:
      setup: SETUP.md
      state: STATE.md
  resources:
    - id: plato-state
      kind: volume
      mount: ./state
      mode: mutable
