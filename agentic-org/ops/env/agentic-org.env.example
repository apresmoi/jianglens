# Copy to ops/secrets/agentic-org.env and fill in real values.
# ops/secrets/ is gitignored.

# GitHub App authentication for the autonomous agents.
# Install the GitHub App on apresmoi/jianglens and apresmoi/jianglens-private.
# The app needs repository permissions:
# Actions read/write, Contents read/write, Issues read/write,
# Pull requests read/write, Checks read-only, Commit statuses read-only,
# Metadata read-only. Keep Workflows disabled unless the maintainer explicitly
# wants agents to edit .github/workflows.
GITHUB_APP_ID=

# Base64-encode the downloaded .pem private key without line wrapping:
#   base64 -i jiang-lens-agents.*.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY_B64=

# Optional. The helper defaults to apresmoi and discovers the installation id.
# Set only if the app is installed somewhere else.
# GITHUB_APP_INSTALLATION_ACCOUNT=apresmoi
# GITHUB_APP_INSTALLATION_ID=

# Container-wide Git credential helper for Spawnfile resource cloning and later
# git push/fetch operations. Keep this literal. The public repo resource is
# cloned first, then this helper finds that checkout and mints a fresh GitHub
# App installation token for private checkouts and authenticated writes.
GIT_CONFIG_COUNT=1
GIT_CONFIG_KEY_0=credential.https://github.com.helper
GIT_CONFIG_VALUE_0=!f() { script="$(find /var/lib/spawnfile/resources/instances -path "*/jiang-lens-repo-*/agentic-org/ops/bin/github-app-token.mjs" -print -quit 2>/dev/null || true)"; if [ -z "$script" ]; then echo "jiang-lens GitHub App helper not found" >&2; exit 1; fi; node "$script" --credential; }; f

# Local Moltnet attachment token.
# Required by Spawnfile-managed agents when Moltnet runs bearer auth with
# public_read enabled and anonymous registration disabled.
# Generate with: openssl rand -hex 32
MOLTNET_AGENT_TOKEN=

# Local Moltnet console/operator token.
# Required for human console send access and remote recovery/admin operations.
# Generate with: openssl rand -hex 32
MOLTNET_OPERATOR_TOKEN=

# Agent schedules are declared in each agent Spawnfile and lowered by Spawnfile
# into PicoClaw's native cron store. Do not seed cron with env vars or host
# scripts.
