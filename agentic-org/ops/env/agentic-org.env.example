# Copy to ops/secrets/agentic-org.env and fill in real values.
# ops/secrets/ is gitignored.

# Fine-grained GitHub token for apresmoi/jianglens and read access to
# apresmoi/jianglens-private.
# Public repo scopes: Contents read/write, Pull requests read/write, Metadata read.
# Private repo scopes: Contents read, Metadata read.
#
# Spawnfile uses this token as the HTTPS git credential while cloning workspace
# resources, including the private corpus resource.
GH_TOKEN=

# Container-wide Git credential helper for Spawnfile resource cloning.
# Keep the value literal; the helper expands GH_TOKEN inside the container.
GIT_CONFIG_COUNT=1
GIT_CONFIG_KEY_0=credential.https://github.com.helper
GIT_CONFIG_VALUE_0=!f() { printf "username=x-access-token\npassword=%s\n" "$GH_TOKEN"; }; f

# Local Moltnet attachment token.
# Required by Spawnfile-managed agents when Moltnet runs bearer auth with
# public_read enabled and anonymous registration disabled.
# Generate with: openssl rand -hex 32
MOLTNET_AGENT_TOKEN=

# Local Moltnet console/operator token.
# Required for human console send access and remote recovery/admin operations.
# Generate with: openssl rand -hex 32
MOLTNET_OPERATOR_TOKEN=

# Agent schedules are declared in each agent Spawnfile and lowered by Spawnfile
# into PicoClaw's native cron store. Do not seed cron with env vars or host
# scripts.
